# Database PostgreSQL URL (Wajib diisi untuk lingkungan produksi)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adably_db?schema=public"

# Auth Secret untuk signing JWT session Superadmin (WAJIB diisi acak >= 32 karakter)
# PERINGATAN: Aplikasi akan fail-fast jika tidak diset atau < 32 karakter.
# Generate: openssl rand -base64 32
AUTH_SECRET="ganti_dengan_kunci_rahasia_acak_minimal_32_karakter_produksi!"

# ─── Base URL Aplikasi ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000" # URL domain publik untuk SEO & sitemap

# ─── Brand & Template Config (P2-10) ──────────────────────────────────────────
# Ganti nilai ini saat re-deploy untuk brand/unit bisnis berbeda
APP_BRAND_SLUG="adably"
APP_COOKIE_PREFIX="adably"
# APP_BASE_URL="http://localhost:3000"  # alias NEXT_PUBLIC_APP_URL, opsional

# ─── Proxy & Rate Limit Config (P0-05) ────────────────────────────────────────
# Jumlah reverse proxy terpercaya di depan aplikasi
# - 0: Tidak ada proxy (development langsung / VPS tanpa Nginx)
# - 1: Satu proxy (Nginx, Coolify dengan satu layer proxy)
# - 2: Dua layer proxy (Cloudflare + Nginx)
# PERINGATAN: Nilai salah membuat rate limit bisa dimanipulasi (IP spoofing)
TRUSTED_PROXY_COUNT=0

# ─── Media Storage Provider ───────────────────────────────────────────────────
# Pilihan: "local" (default) | "s3" | "r2" | "cloudinary"
STORAGE_PROVIDER="local"

# --- Konfigurasi S3 / Cloudflare R2 (jika STORAGE_PROVIDER="s3" atau "r2") ---
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_BUCKET_NAME="adably-uploads"
# S3_PUBLIC_URL="https://cdn.adably.id"
# S3_ACCESS_KEY_ID="your_access_key_id"
# S3_SECRET_ACCESS_KEY="your_secret_access_key"
# S3_REGION="auto"

# --- Konfigurasi Cloudinary (jika STORAGE_PROVIDER="cloudinary") ---
# CLOUDINARY_CLOUD_NAME="your_cloud_name"
# CLOUDINARY_API_KEY="your_cloudinary_api_key"
# CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
# CLOUDINARY_UPLOAD_PRESET="your_preset"  # opsional

# ─── Coolify / Self-hosted Deployment ────────────────────────────────────────
# URL internal Coolify (untuk preview di PDF katalog jika menggunakan link internal)
# COOLIFY_URL="http://coolify-internal:3000"

# ─── Audit Log Retention (P2-12) ─────────────────────────────────────────────
# Sudah dikonfigurasi via SiteSetting.auditRetentionDays di database (default: 365)

# ─── Dev & Resilience (JANGAN aktifkan di produksi) ──────────────────────────
# Izinkan fallback login admin saat PostgreSQL lokal mati (hanya NODE_ENV=development)
ALLOW_DEV_FALLBACK_LOGIN="false"

# Izinkan fallback penulisan data ke .local-store.json saat database offline.
# Di produksi (NODE_ENV=production), biarkan 'false' untuk fail-loud.
ALLOW_LOCAL_FALLBACK="false"

# Paksa penggunaan local store JSON tanpa percobaan ke database (dev/testing offline)
# FORCE_LOCAL_STORE="false"
